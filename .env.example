# ============================================================
#  You do NOT have to fill in anything here.
#
#  The default channel ("local" in config.yaml) writes digest.html
#  in the project folder every morning and needs no credentials.
#
#  Fill in a block below only if you want the digest pushed to your
#  phone, then add that channel to delivery.channels in config.yaml.
# ============================================================

# ---- Option A: Telegram — fastest, no email account, no 2FA ----
# 1. In Telegram, message @BotFather and send /newbot
# 2. Paste the token it gives you below
# 3. Send your new bot any message so it is allowed to reply.
# TELEGRAM_CHAT_ID fills itself in on the first send — leave it blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Option B: Email via Brevo — 300 emails/day free, no 2FA ----
# Sign up at https://www.brevo.com, then SMTP & API -> SMTP -> Generate key.
# SMTP_USER is the login Brevo shows you, SMTP_PASSWORD is the generated key.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#
# ---- Option B2: Email via Gmail ----
# Needs 2-Step Verification, then an App Password:
# https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# Any other SMTP provider works too — only these three values change.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM=
MAIL_TO=shakurtatum@gmail.com

# ---- Option C: Discord ----
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ---- Optional: Adzuna job API (free, widens Kenyan coverage) ----
# Register at https://developer.adzuna.com/ then paste the IDs here.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
